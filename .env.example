# Copy this file to .env and fill in real values. Never commit .env.

# --- Twilio (SMS delivery) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# If you use a Messaging Service instead of a single number, set this
# and leave TWILIO_FROM_NUMBER blank:
TWILIO_MESSAGING_SERVICE_SID=

# --- Stripe (billing) ---
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_WEBHOOK_SECRET=

# --- App ---
APP_NAME=In Rhythm
APP_BASE_URL=http://localhost:3000
COACH_NAME=Dr. Terry Daniels
# Shown in the opt-in confirmation text ("text or call me directly at...")
# and used to text you when a new subscriber signs up. Any US number format
# works (digits only, or with dashes/parens) - leave blank to skip both.
COACH_CELL=
# Shared code that gives someone free/client access at signup (see README)
CLIENT_ACCESS_CODE=
PORT=3000

# Simple shared secret admin routes use (change this)
ADMIN_TOKEN=change-me
